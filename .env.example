# GOTXA Stack - Environment Configuration

# ============================================================================
# BACKEND API
# ============================================================================
DATABASE_URL=postgresql://siem_user:replace-with-db-password@siem-postgres:5432/siem_db
POSTGRES_USER=siem_user
POSTGRES_PASSWORD=replace-with-db-password
POSTGRES_DB=siem_db
FLASK_ENV=production
DEBUG=False
LOG_LEVEL=INFO

# API Server
API_HOST=0.0.0.0
API_PORT=5000

# ============================================================================
# FRONTEND APPLICATIONS
# ============================================================================

# SIEM/SOAR Frontend
SIEM_FRONTEND_PORT=3001
SIEM_API_URL=http://localhost/api

# Corp Portal Frontend
CORP_PORTAL_PORT=3002
CORP_API_URL=http://localhost/api

# SCADA Dashboard
SCADA_FRONTEND_PORT=3003
SCADA_API_URL=http://localhost/api

# ============================================================================
# GATEWAY/REVERSE PROXY
# ============================================================================
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=80
GATEWAY_HTTPS_PORT=443

# Service URLs (internal - used by gateway)
BACKEND_URL=http://backend:5000
SIEM_URL=http://siem-soar-frontend:80
CORP_URL=http://corp-portal-frontend:80
SCADA_URL=http://scada-frontend:80

# ============================================================================
# DATABASE
# ============================================================================
DB_HOST=siem-postgres
DB_PORT=5432
DB_USER=siem_user
DB_PASSWORD=[REDACTED]
DB_NAME=siem_db

# ============================================================================
# SECURITY
# ============================================================================
JWT_SECRET=[REDACTED]
SESSION_SECRET=[REDACTED]
API_RATE_LIMIT=100
# Required to authenticate a log collector. Generate a unique high-entropy value
# for each deployment; never commit the populated .env file.
COLLECTOR_INGEST_TOKEN=replace-with-a-random-32-byte-secret

# ============================================================================
# CORS & ALLOWED ORIGINS
# ============================================================================
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
